# ── Secrets — never commit this file ─────────────────────────────────────────
# Copy to .env and fill in your values.
# Frontend vars must be prefixed VITE_ so Vite embeds them at build time.

# Node.js API Gateway (Sprint 4)
NODE_PORT=5000
VITE_API_URL=http://localhost:5000

# Supabase (React, Node.js Gateway, and Python ML service use these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Python ML Microservice (FastAPI)
ML_API_URL=http://localhost:8000
