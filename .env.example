# ── Secrets — never commit this file ─────────────────────────────────────────
# Copy to .env and fill in your values.
# Frontend vars must be prefixed VITE_ so Vite embeds them at build time.

# Supabase (both frontend and backend use the same publishable/anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key

# Python backend (same values, different prefix convention)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Batch script — change to your deployed Render URL in production
# e.g. https://supply-chain-risk-api.onrender.com
ML_API_URL=http://localhost:8000
